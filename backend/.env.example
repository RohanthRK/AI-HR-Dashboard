# Copy this file to .env and fill in real values
# DO NOT commit the actual .env file to git

SECRET_KEY=generate-a-strong-random-secret-key-here
DEBUG=False
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_NAME=hr_dashboard_db
ALLOWED_HOSTS=your-render-app.onrender.com
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
# AI providers - set one or both. When both are set the app falls back to the other one on rate limits.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_ORDER=gemini,groq

# Optional single sign-on (users must already exist; matched by verified e-mail)
# Redirect URI to register: <SSO_BACKEND_URL>/api/auth/sso/<google|microsoft>/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
SSO_BACKEND_URL=https://your-render-app.onrender.com
FRONTEND_URL=https://your-vercel-app.vercel.app

# Optional delivery of notifications outside the app (switch them on in Settings -> Notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=hr@example.com
EMAIL_USE_TLS=true
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...   # Slack or Teams incoming webhook
